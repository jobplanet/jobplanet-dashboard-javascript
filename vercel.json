{
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/public-snapshot",
      "schedule": "0 21 * * *"
    }
  ]
}
